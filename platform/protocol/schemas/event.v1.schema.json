{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-intelligence-engine.local/protocol/event.v1.schema.json",
  "title": "Document Intelligence Event v1",
  "oneOf": [
    {"$ref": "#/$defs/job_started"},
    {"$ref": "#/$defs/run_configured"},
    {"$ref": "#/$defs/stage_started"},
    {"$ref": "#/$defs/stage_progress"},
    {"$ref": "#/$defs/stage_warning"},
    {"$ref": "#/$defs/artifact_ready"},
    {"$ref": "#/$defs/stage_completed"},
    {"$ref": "#/$defs/stage_failed"},
    {"$ref": "#/$defs/job_succeeded"},
    {"$ref": "#/$defs/job_failed"},
    {"$ref": "#/$defs/job_cancelled"}
  ],
  "$defs": {
    "base_event": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "job_id",
        "run_id",
        "attempt_id",
        "sequence",
        "type",
        "timestamp"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "event_id": {"type": "string", "minLength": 1},
        "job_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "type": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "stage": {
      "enum": [
        "configure",
        "open",
        "render",
        "text",
        "layout",
        "table",
        "reading_order",
        "assembly",
        "export"
      ]
    },
    "backend_options": {
      "type": "object",
      "required": ["document", "ocr", "layout", "table", "registry_config"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "ocr": {"type": "string", "minLength": 1},
        "layout": {"type": "string", "minLength": 1},
        "table": {"type": "string", "minLength": 1},
        "registry_config": {"type": "string"}
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": ["name", "version", "git_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "git_revision": {"type": "string"}
      },
      "additionalProperties": false
    },
    "configured_backends": {
      "type": "object",
      "required": ["requested", "resolved", "config_source"],
      "properties": {
        "requested": {"$ref": "#/$defs/backend_options"},
        "resolved": {"$ref": "#/$defs/backend_options"},
        "config_source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["stage", "backend", "role", "path"],
      "properties": {
        "stage": {"$ref": "#/$defs/stage"},
        "backend": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["completed", "total"],
      "properties": {
        "completed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "message", "details"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "job_started": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "properties": {"type": {"const": "job_started"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "run_configured": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["engine", "backends", "models"],
          "properties": {
            "type": {"const": "run_configured"},
            "engine": {"$ref": "#/$defs/engine"},
            "backends": {"$ref": "#/$defs/configured_backends"},
            "models": {
              "type": "array",
              "items": {"$ref": "#/$defs/model"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stage_started": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["stage", "backend"],
          "properties": {
            "type": {"const": "stage_started"},
            "stage": {"$ref": "#/$defs/stage"},
            "backend": {"type": "string", "minLength": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stage_progress": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["stage", "progress"],
          "properties": {
            "type": {"const": "stage_progress"},
            "stage": {"$ref": "#/$defs/stage"},
            "backend": {"type": "string", "minLength": 1},
            "progress": {"$ref": "#/$defs/progress"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stage_warning": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["stage", "warning"],
          "properties": {
            "type": {"const": "stage_warning"},
            "stage": {"$ref": "#/$defs/stage"},
            "page_number": {"type": "integer", "minimum": 1},
            "warning": {"$ref": "#/$defs/warning"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "artifact_ready": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["stage", "artifact_id"],
          "properties": {
            "type": {"const": "artifact_ready"},
            "stage": {"$ref": "#/$defs/stage"},
            "artifact_id": {"type": "string", "minLength": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stage_completed": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["stage", "duration_ms"],
          "properties": {
            "type": {"const": "stage_completed"},
            "stage": {"$ref": "#/$defs/stage"},
            "duration_ms": {"type": "integer", "minimum": 0}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stage_failed": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["stage", "error"],
          "properties": {
            "type": {"const": "stage_failed"},
            "stage": {"$ref": "#/$defs/stage"},
            "error": {"$ref": "#/$defs/error"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "job_succeeded": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "properties": {"type": {"const": "job_succeeded"}}
        }
      ],
      "unevaluatedProperties": false
    },
    "job_failed": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "required": ["error"],
          "properties": {
            "type": {"const": "job_failed"},
            "error": {"$ref": "#/$defs/error"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "job_cancelled": {
      "allOf": [
        {"$ref": "#/$defs/base_event"},
        {
          "type": "object",
          "properties": {
            "type": {"const": "job_cancelled"},
            "error": {"$ref": "#/$defs/error"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
